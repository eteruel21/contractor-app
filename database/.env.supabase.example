# SUPABASE - BASE PRINCIPAL
#
# Preferir la conexion directa para migraciones, pg_dump y backups.
# Si la red es IPv4-only, usar Session Pooler en puerto 5432.
# Copiar los datos exactos desde Supabase Dashboard > Connect.
#
# Nunca guardar contrasenas reales en Git.

SUPABASE_PROJECT_REF=PROJECT_REF

SUPABASE_ADMIN_URL=postgresql://postgres.PROJECT_REF:REEMPLAZAR@aws-0-REGION.pooler.supabase.com:5432/postgres

CONTRACTOR_MIGRATOR_PASSWORD=REEMPLAZAR
CONTRACTOR_API_PASSWORD=REEMPLAZAR

MIGRATOR_DATABASE_URL=postgresql://contractor_migrator.PROJECT_REF:REEMPLAZAR@aws-0-REGION.pooler.supabase.com:5432/postgres

# Descargar Server root certificate desde:
# Supabase Dashboard > Database Settings > SSL Configuration
DATABASE_SSL_CA_FILE=database/certs/supabase-ca.crt

# DESTINO LOCAL EXCLUSIVO DEL RESPALDO.
# Debe ser localhost y el nombre debe contener backup, restore o mirror.
# El script puede eliminar y recrear ESTA base local.
LOCAL_BACKUP_DATABASE_URL=postgresql://postgres:REEMPLAZAR@localhost:5432/contractor_pro_backup

# Solo configurar temporalmente cuando se pretenda ejecutar un reset.
# Debe ser exactamente RESET_<SUPABASE_PROJECT_REF>.
# SUPABASE_RESET_CONFIRMATION=RESET_PROJECT_REF