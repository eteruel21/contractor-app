{
  "name": "contractor-api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_ENV": "production",
    "DATABASE_MODE": "hyperdrive"
  },
  "secrets": {
    "required": [
      "JWT_SECRET"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7a329598e4b04653b28173862646054e"
    }
  ],
  "workers_dev": false,
  "preview_urls": true
}
