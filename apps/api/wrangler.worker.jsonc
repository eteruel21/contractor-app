{
  "name": "contractor-api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_ENV": "production",
    "DATABASE_MODE": "hyperdrive",
    "TURNSTILE_ALLOWED_HOSTNAMES": "contractor-pro-web.pages.dev,contractor-admin-web.pages.dev,app.contractor.com.pa,admin.contractor.com.pa"
  },
  "secrets": {
    "required": [
      "JWT_SECRET"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7a329598e4b04653b28173862646054e"
    }
  ],
  "routes": [
    {
      "pattern": "api.tctservices-pty.com/*",
      "zone_name": "tctservices-pty.com"
    }
  ],
  "workers_dev": false,
  "preview_urls": true
}
