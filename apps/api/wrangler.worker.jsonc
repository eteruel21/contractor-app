{
  "name": "contractor-api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_ENV": "production",
    "DATABASE_MODE": "hyperdrive",
    "TURNSTILE_ALLOWED_HOSTNAMES": "app.leurettech.com,admin.leurettech.com"
  },
  "secrets": {
    "required": [
      "JWT_SECRET",
      "TURNSTILE_SECRET_KEY",
      "RESEND_API_KEY",
      "EMAIL_FROM"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7a329598e4b04653b28173862646054e"
    }
  ],
  "routes": [
    {
      "pattern": "api.leurettech.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": true
}
