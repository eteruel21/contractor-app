NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001

# Copiar estos valores desde Supabase Dashboard > Connect.
#
# Backend persistente:
# - Direct Connection cuando IPv6 esté disponible.
# - Session Pooler cuando el servidor sea IPv4-only.

PGHOST=REEMPLAZAR_CON_HOST_DE_SUPABASE
PGPORT=5432
PGDATABASE=postgres
PGUSER=contractor_api
PGPASSWORD=REEMPLAZAR
PGSSL=verify-full
# Descargar Server root certificate desde:
# Supabase Dashboard > Database Settings > SSL Configuration
# En producción usar una ruta absoluta accesible por el proceso API.
PGSSL_CA_FILE=REEMPLAZAR_CON_RUTA_ABSOLUTA_AL_CERTIFICADO_CA

JWT_SECRET=GENERAR_SECRETO_ALEATORIO_DE_AL_MENOS_43_CARACTERES
JWT_ISSUER=contractor-api
JWT_AUDIENCE=contractor-app

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=https://contractor-pro-web.pages.dev,https://contractor-admin-web.pages.dev